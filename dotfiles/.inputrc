# Case-insensitive completion
set completion-ignore-case on

# Up/Down walk through history entries that start with the text typed so far
"\e[A": history-search-backward
"\e[B": history-search-forward

# Only offer dotfiles when the pattern itself starts with a dot
set match-hidden-files off

# List every completion at once instead of paging
set page-completions off

# Ask before listing more than 200 completions
set completion-query-items 200

# When completing mid-word, do not duplicate the characters already after the cursor
set skip-completed-text on
